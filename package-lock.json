{
  "name": "agentshield-sh",
  "version": "0.1.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "agentshield-sh",
      "version": "0.1.0",
      "license": "AGPL-3.0-or-later",
      "workspaces": [
        "packages/*"
      ],
      "bin": {
        "agentshield": "packages/cli/src/index.js"
      },
      "engines": {
        "node": ">=20.9.0"
      }
    },
    "node_modules/@agentshield/cli": {
      "resolved": "packages/cli",
      "link": true
    },
    "node_modules/@agentshield/core": {
      "resolved": "packages/core",
      "link": true
    },
    "node_modules/@agentshield/dashboard-server": {
      "resolved": "packages/dashboard-server",
      "link": true
    },
    "packages/cli": {
      "name": "@agentshield/cli",
      "version": "0.1.0",
      "license": "AGPL-3.0-or-later",
      "bin": {
        "agentshield": "src/index.js"
      }
    },
    "packages/core": {
      "name": "@agentshield/core",
      "version": "0.1.0",
      "license": "AGPL-3.0-or-later"
    },
    "packages/dashboard-server": {
      "name": "@agentshield/dashboard-server",
      "version": "0.1.0",
      "license": "AGPL-3.0-or-later"
    }
  }
}
